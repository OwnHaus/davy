#!/bin/sh
# fuzz/run in rust:bookworm with nightly, so it works on macOS. FUZZ_CPUS caps
# the cores the container takes.
# Usage: fuzz/docker SECONDS [TARGET...]
set -eu
ROOT=$(cd "$(dirname "$0")/.." && pwd)
docker run --rm --cpus "${FUZZ_CPUS:-6}" -v "$ROOT":/src \
  -v davy-cargo:/usr/local/cargo/registry -v davy-rustup:/usr/local/rustup \
  -v davy-fuzz-bin:/fuzzbin -v davy-fuzz-target:/target \
  -e CARGO_TARGET_DIR=/target -e FUZZ_LOGS=/target/logs -w /src rust:bookworm sh -euc '
    rustup toolchain install nightly --profile minimal >/dev/null 2>&1
    [ -x /fuzzbin/bin/cargo-fuzz ] || cargo install --locked --root /fuzzbin cargo-fuzz@0.13.2
    PATH=/fuzzbin/bin:$PATH fuzz/run "$@"
  ' sh "$@"
