#!/bin/sh
# The one gate every change passes: the pre-commit hook, the agent Stop hook and
# CI all run this script. Fix the code, never this script, to make it pass.
set -eu
cd "$(dirname "$0")/.."

fail=0
problem() {
    printf 'check: %s\n' "$1" >&2
    fail=1
}

cargo fmt --check || problem 'run cargo fmt'
cargo fmt --check --manifest-path fuzz/Cargo.toml || problem 'run cargo fmt --manifest-path fuzz/Cargo.toml'
cargo clippy --all-targets --locked --quiet -- -D warnings || problem 'clippy has findings'
cargo test --locked --quiet || problem 'tests fail'

if command -v cargo-deny >/dev/null 2>&1; then
    cargo deny --log-level error check || problem 'cargo deny has findings'
else
    printf 'check: cargo-deny is not installed, skipping (brew install cargo-deny)\n' >&2
fi

if command -v zizmor >/dev/null 2>&1; then
    zizmor --offline --quiet .github/workflows || problem 'zizmor has findings in the workflows'
else
    printf 'check: zizmor is not installed, skipping (brew install zizmor)\n' >&2
fi

# The web UI, when Node and pnpm are here. CI has both, so CI always runs it.
# The build goes to target/ui-check, so a check never changes what the next
# cargo build embeds from ui/dist.
if command -v pnpm >/dev/null 2>&1 && command -v node >/dev/null 2>&1; then
    scripts/ui ../target/ui-check || problem 'the UI fails its type check, build or bundle budget'
    (cd ui && pnpm licenses list --prod --json) | node scripts/ui-licenses.mjs ||
        problem 'a bundled npm package has a license outside the list'
    # Every string in the UI came from an SDK or a person, so it reaches the
    # page as text and never as markup or code.
    if git grep --untracked -nE 'dangerouslySetInnerHTML|innerHTML|outerHTML|insertAdjacentHTML|document\.write|(^|[^A-Za-z0-9_$])eval\(|new Function' -- ui/src; then
        problem 'markup or code built from a string in the lines above, render text instead'
    fi
else
    printf 'check: pnpm or node is missing, skipping the UI (see CONTRIBUTING.md)\n' >&2
    [ -z "${CI:-}" ] || problem 'CI runs the UI checks, so it needs pnpm and node'
fi
# The website's roadmap is written from roadmap.json, which this also checks.
if command -v node >/dev/null 2>&1; then
    node site/tools/roadmap.cjs --check || problem 'roadmap.json or the site is wrong, see the lines above'
else
    printf 'check: node is missing, skipping the roadmap (see CONTRIBUTING.md)\n' >&2
    [ -z "${CI:-}" ] || problem 'CI checks the roadmap, so it needs node'
fi
if command -v osv-scanner >/dev/null 2>&1; then
    if ! found=$(osv-scanner scan --lockfile ui/pnpm-lock.yaml 2>&1); then
        printf '%s\n' "$found" >&2
        problem 'osv-scanner finds a known vulnerability in ui/pnpm-lock.yaml'
    fi
else
    printf 'check: osv-scanner is not installed, skipping (brew install osv-scanner)\n' >&2
    [ -z "${CI:-}" ] || problem 'CI scans the UI lockfile, so it needs osv-scanner'
fi

scripts/test-commit-msg || problem 'scripts/commit-msg fails its table test'
scripts/test-release || problem 'scripts/release fails its test'

# Prose and code are written without the long dash. Captured fixtures stay as
# the client sent them.
dash=$(printf '\342\200\224')
if git grep --untracked -nI -e "$dash" -- . ':!e2e/fixtures' ':!*.lock' ':!*pnpm-lock.yaml'; then
    problem 'long dash in the lines above, rewrite the sentence'
fi

# A deferred task needs an issue link, or it is never done.
if git grep --untracked -nIwE 'TODO|FIXME|XXX|HACK' -- src examples e2e/*.mjs e2e/*.sh bench ':!scripts/check' | grep -v 'https://'; then
    problem 'TODO without a link in the lines above'
fi

# Tests wait for the event they expect and none is skipped. scripts/test-sleeps
# lists the sleeps that remain, and the counts must match it exactly.
sleeps=$(git grep --untracked -c -e 'sleep(' -- 'src/*tests.rs' 'src/tests/*' 'examples/*tests.rs' || true)
if ! printf '%s\n' "$sleeps" | awk -F: '
    BEGIN {
        while ((getline line < "scripts/test-sleeps") > 0) {
            if (line ~ /^#/ || line == "") continue
            split(line, a, " ")
            allowed[a[1]] = a[2]
        }
    }
    NF { found[$1] = $2 }
    END {
        bad = 0
        for (f in allowed) if (!(f in found)) found[f] = 0
        for (f in found) if (found[f] != allowed[f] + 0) {
            printf "check: %s has %d sleeps, scripts/test-sleeps lists %d\n", f, found[f], allowed[f] + 0 > "/dev/stderr"
            bad = 1
        }
        exit bad
    }'; then
    problem 'wait for the event instead of sleeping, or lower the count in scripts/test-sleeps when a sleep goes'
fi
if git grep --untracked -n -e '#\[ignore' -- src examples; then
    problem 'an ignored test in the lines above, fix it or delete it'
fi

# Big files are where agents pile up unrelated code. Split by responsibility.
max_lines=700
for f in $(git ls-files --cached --others --exclude-standard 'src/*.rs' 'src/**/*.rs' 'examples/*.rs'); do
    n=$(wc -l <"$f")
    if [ "$n" -gt "$max_lines" ]; then
        problem "$f has $n lines, the limit is $max_lines"
    fi
done

if [ "$fail" -ne 0 ]; then
    exit 1
fi
printf 'check: ok\n'
