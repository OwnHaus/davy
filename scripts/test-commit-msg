#!/bin/sh
# Table test for scripts/commit-msg: each case is a message and the exact
# problem it must report, or "ok". scripts/check runs it.
set -eu
cd "$(dirname "$0")/.."

dir=$(mktemp -d)
trap 'rm -rf "$dir"' EXIT
fail=0
case_is() {
    printf '%b' "$1" >"$dir/msg"
    if got=$(scripts/commit-msg "$dir/msg" 2>&1); then got=ok; fi
    if [ "$got" != "$(printf '%b' "$2")" ]; then
        printf 'test-commit-msg: for %s\n  want: %s\n  got:  %s\n' "$1" "$2" "$got" >&2
        fail=1
    fi
}

long='feat(alert): send alerts over SMTP with required STARTTLS and a deadline'
case_is 'feat(alert): send alerts by e-mail over SMTP\n' ok
case_is 'fix(http)!: refuse bodies over 1 MiB before they inflate\n\nA client without a key could make the server allocate 4.4 GB.\n' ok
case_is 'docs(repo): zkrátit popis na sedmdesát dva znaků, čeština se počítá po\n' ok
case_is "$long\n" ok
case_is "${long}s\n" 'commit-msg: the subject has 73 characters, the limit is 72'
case_is 'feat(alert): send alerts\n# Please enter the commit message\n# ------------------------ >8 ------------------------\n- old line\n' ok
case_is '\n' 'commit-msg: the subject line is empty'
case_is 'Send alerts by e-mail\n' 'commit-msg: the subject is type(scope): description, e.g. feat(alert): send alerts by e-mail'
case_is 'feat: send alerts\n' 'commit-msg: the subject is type(scope): description, e.g. feat(alert): send alerts by e-mail'
case_is 'feature(alert): send alerts\n' 'commit-msg: "feature" is not a type, use one of: feat fix perf refactor test docs build ci chore revert'
case_is 'feat(cloud): send alerts\n' 'commit-msg: "cloud" is not a scope, use one of: http errors logs sourcemaps mcp monitor alert core net cli ui e2e bench deps release security repo site'
case_is 'feat(alert): Send alerts\n' 'commit-msg: the description starts with a lowercase verb'
case_is 'feat(alert): send alerts.\n' 'commit-msg: the subject ends without a period'
case_is 'feat(alert): added e-mail alerts\n' 'commit-msg: the description is imperative: "added" reads as a report, write what the commit does (add, fix, update)'
case_is 'fixup! feat(alert): send alerts\n' 'commit-msg: the subject is type(scope): description, e.g. feat(alert): send alerts by e-mail\ncommit-msg: a fixup or WIP commit does not land, fold it into the commit it fixes'
case_is 'feat(alert): send alerts\nby e-mail\n' 'commit-msg: a blank line separates the subject from the body'
case_is 'feat(alert): send alerts \342\200\224 by e-mail\n' 'commit-msg: the message has a long dash, rewrite the sentence'
case_is 'feat(alert): send alerts\n\nCo-Authored-By: Claude Opus <noreply@anthropic.com>\n' 'commit-msg: the message credits an AI model as co-author, remove the trailer'
case_is 'feat(alert): send alerts\n\nCo-authored-by: Jana Novak <jana@example.com>\n' ok
case_is 'feat(alert): send alerts\n\n\360\237\244\226 Generated with [Claude Code](https://claude.com/claude-code)\n' 'commit-msg: the message says an AI tool made it, remove the line'
case_is 'feat(alert): send alerts\n\nGenerated by AI.\n' 'commit-msg: the message says an AI tool made it, remove the line'
case_is 'feat(mcp): send prompts to OpenAI from the agent\n\nThe body is generated by the SDK.\n' ok

for scope in $(scripts/commit-msg --scopes); do
    if ! grep -q "^| \`$scope\` |" CONTRIBUTING.md; then
        printf 'test-commit-msg: scope %s has no row in CONTRIBUTING.md\n' "$scope" >&2
        fail=1
    fi
done

exit "$fail"
