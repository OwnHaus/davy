#!/bin/sh
# Table test for scripts/commit-msg: each case is a message and the exact
# problem it must report, or "ok". scripts/check runs it.
set -eu
cd "$(dirname "$0")/.."

dir=$(mktemp -d)
trap 'rm -rf "$dir"' EXIT
fail=0
case_is() {
    printf '%b' "$1" >"$dir/msg"
    if got=$(scripts/commit-msg "$dir/msg" 2>&1); then got=ok; fi
    if [ "$got" != "$(printf '%b' "$2")" ]; then
        printf 'test-commit-msg: for %s\n  want: %s\n  got:  %s\n' "$1" "$2" "$got" >&2
        fail=1
    fi
}

long='Send alerts by e-mail over SMTP with required STARTTLS and a 10s timeout'
case_is 'Send alerts by e-mail over SMTP\n' ok
case_is 'Send alerts by e-mail\n\nlettre is MIT and pulls in 5 crates.\n' ok
case_is 'Zkrátit popis chyby na sedmdesát dva znaků, čeština se počítá po znacích\n' ok
case_is "$long\n" ok
case_is "${long}s\n" 'commit-msg: the subject has 73 characters, the limit is 72'
case_is 'Send alerts\n# Please enter the commit message\n# ------------------------ >8 ------------------------\n- old line\n' ok
case_is '\n' 'commit-msg: the subject line is empty'
case_is 'send alerts\n' 'commit-msg: the subject starts with a capital letter'
case_is 'Send alerts.\n' 'commit-msg: the subject ends without a period'
case_is 'Added e-mail alerts\n' 'commit-msg: the subject is imperative: "Added" reads as a report, write what the commit does (Add, Fix, Update)'
case_is 'fixup! Send alerts\n' 'commit-msg: the subject starts with a capital letter\ncommit-msg: a fixup or WIP commit does not land, fold it into the commit it fixes'
case_is 'WIP\n' 'commit-msg: a fixup or WIP commit does not land, fold it into the commit it fixes'
case_is 'Send alerts\nby e-mail\n' 'commit-msg: a blank line separates the subject from the body'
case_is 'Send alerts \342\200\224 by e-mail\n' 'commit-msg: the message has a long dash, rewrite the sentence'
case_is 'Send alerts\n\nCo-Authored-By: Claude Opus <noreply@anthropic.com>\n' 'commit-msg: the message credits an AI model as co-author, remove the trailer'
case_is 'Send alerts\n\nCo-authored-by: Jana Novak <jana@example.com>\n' ok
case_is 'Send alerts\n\n\360\237\244\226 Generated with [Claude Code](https://claude.com/claude-code)\n' 'commit-msg: the message says an AI tool made it, remove the line'
case_is 'Send alerts\n\nGenerated by AI.\n' 'commit-msg: the message says an AI tool made it, remove the line'
case_is 'Send prompts to OpenAI from the agent\n\nThe body is generated by the SDK.\n' ok

exit "$fail"
